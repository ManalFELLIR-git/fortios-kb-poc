from pathlib import Path
from collections import Counter
from decimal import Decimal, InvalidOperation
import argparse
import re
import yaml


parser = argparse.ArgumentParser()

parser.add_argument(
    "--version",
    required=True
)

parser.add_argument(
    "--samples",
    type=int,
    default=30
)

args = parser.parse_args()


ROOT = (
    Path("knowledge_base")
    / "fortios"
    / args.version
)

INPUT = (
    ROOT
    / "audit"
    / "range_conflict_evidence.yaml"
)

OUTPUT = (
    ROOT
    / "audit"
    / "range_resolution.yaml"
)


data = yaml.safe_load(
    INPUT.read_text(
        encoding="utf-8"
    )
)

records = data.get(
    "records",
    []
)


def number(value):

    try:
        return Decimal(
            str(value)
        )

    except (
        InvalidOperation,
        ValueError,
        TypeError
    ):
        return None


def number_text(value):

    value = number(value)

    if value is None:
        return None

    if value == value.to_integral():
        return str(int(value))

    return format(
        value,
        "f"
    )


def simple_ranges(text):
    """
    Récupère des ranges textuels simples :

        1 - 10
        12 to 128
        0 – 65535
        20 - 3600 * 1000

    Les expressions restent volontairement limitées
    à une multiplication numérique simple.
    """

    if not text:
        return []

    pattern = re.compile(
        r"(?<![\d.])"
        r"(-?\d+(?:\.\d+)?)"
        r"\s*(?:-|–|—|to)\s*"
        r"(-?\d+(?:\.\d+)?)"
        r"(?:\s*\*\s*(-?\d+(?:\.\d+)?))?"
        r"(?![\d.])",
        re.I,
    )

    result = []

    for m in pattern.finditer(
        str(text)
    ):

        a = number(
            m.group(1)
        )

        b = number(
            m.group(2)
        )

        multiplier = number(
            m.group(3)
        ) if m.group(3) else None

        if (
            b is not None
            and multiplier is not None
        ):
            b = b * multiplier

        if (
            a is not None
            and b is not None
        ):
            result.append(
                (a, b)
            )

    return result

def description_supports_range(
    description,
    min_value,
    max_value,
):

    mn = number(min_value)
    mx = number(max_value)

    if (
        mn is None
        or mx is None
    ):
        return False

    return (
        (mn, mx)
        in simple_ranges(
            description
        )
    )


def units(text):

    text = str(
        text or ""
    ).lower()

    groups = {

        "milliseconds": (
            "millisecond",
            "milliseconds",
            "msec",
        ),

        "seconds": (
            " second",
            " seconds",
            " sec",
        ),

        "minutes": (
            "minute",
            "minutes",
        ),

        "hours": (
            "hour",
            "hours",
        ),

        "days": (
            "day",
            "days",
        ),

        "kbps": (
            "kbps",
        ),

        "bytes": (
            "byte",
            "bytes",
        ),
    }

    result = set()

    for canonical, names in (
        groups.items()
    ):

        if any(
            name in text
            for name in names
        ):

            result.add(
                canonical
            )

    return result


def explicit_platform_dependency(
    text
):

    text = str(
        text or ""
    ).lower()

    phrases = (
        "depend on the number of cpu",
        "depends on the number of cpu",
        "depend on the model",
        "depends on the model",
        "depending on the model",
        "number of cpus",
        "number of cpu cores",
        "only available on fortigate units with multiple cpus",
        "hardware dependent",
        "platform dependent",
    )

    return any(
        phrase in text
        for phrase in phrases
    )


def explicit_zero_special(
    text
):

    text = str(
        text or ""
    ).lower()

    patterns = (
        r"\b0\b\s+means\s+",
        r"\b0\b\s*=\s*",
        r"\b0\b\s*-\s*always",
        r"\b0\b\s+to\s+disable",
        r"\b0\b.*unlimited",
        r"default value of zero means",
    )

    return any(
        re.search(
            pattern,
            text
        )
        for pattern in patterns
    )


summary = Counter()

final_records = []


for item in records:

    item = dict(item)

    evidence = item.get(
        "evidence",
        {}
    )

    cli = evidence.get(
        "cli_reference",
        {}
    )

    tf = evidence.get(
        "terraform",
        {}
    )

    ans = evidence.get(
        "ansible",
        {}
    )


    cli_desc = str(
        cli.get(
            "description",
            ""
        )
    )

    ans_desc = str(
        ans.get(
            "description",
            ""
        )
    )


    cli_min = cli.get("min")
    cli_max = cli.get("max")

    tf_min = tf.get("min")
    tf_max = tf.get("max")


    ans_ranges = simple_ranges(
        ans_desc
    )


    ans_supports_cli = (
        description_supports_range(
            ans_desc,
            cli_min,
            cli_max,
        )
    )


    ans_supports_tf = (
        description_supports_range(
            ans_desc,
            tf_min,
            tf_max,
        )
    )


    cli_units = units(
        cli_desc
    )

    ans_units = units(
        ans_desc
    )


    unit_mismatch = (
        bool(cli_units)
        and bool(ans_units)
        and cli_units.isdisjoint(
            ans_units
        )
    )


    combined_desc = (
        cli_desc
        + " "
        + ans_desc
    )


    platform = (
        explicit_platform_dependency(
            combined_desc
        )
    )


    zero_special = (
        explicit_zero_special(
            combined_desc
        )
    )


    # Default en dehors du range normal CLI :
    # autre signal fort de valeur sentinelle.
    cli_default = number(
        cli.get("default")
    )

    mn = number(
        cli_min
    )

    mx = number(
        cli_max
    )

    default_outside_range = False

    if (
        cli_default is not None
        and mn is not None
        and mx is not None
    ):

        default_outside_range = (
            cli_default < mn
            or cli_default > mx
        )


    # --------------------------------------------------------
    # Vérifier si la description CLI contredit elle-même
    # les champs structurés min/max.
    #
    # Exemple :
    #
    # description : 10 - 3600
    # min structuré: 180
    # max structuré: 3600
    #
    # Dans ce cas on ne tranche pas automatiquement.
    # --------------------------------------------------------

    cli_ranges_detected = simple_ranges(
        cli_desc
    )

    cli_structured_range = None

    if (
        mn is not None
        and mx is not None
    ):
        cli_structured_range = (
            mn,
            mx,
        )

    cli_internal_inconsistency = (
        bool(cli_ranges_detected)
        and cli_structured_range is not None
        and cli_structured_range
        not in cli_ranges_detected
    )


    special_values = []

    if (
        zero_special
        or (
            default_outside_range
            and cli_default == 0
        )
    ):
        special_values.append(0)


    # ========================================================
    # RULE 0 — contradiction interne dans la source officielle
    #
    # Ne jamais choisir automatiquement lorsque la CLI
    # structurée et sa propre description ne sont pas
    # cohérentes.
    # ========================================================

    if cli_internal_inconsistency:

        resolution = (
            "official_cli_internal_inconsistency"
        )

        status = "unresolved"

        confidence = "needs_review"

        canonical_policy = None


    # ========================================================
    # RULE 1 — dépendance hardware / plateforme explicite
    # ========================================================

    elif platform:

        resolution = (
            "platform_dependent_range"
        )

        status = "resolved"

        confidence = "high"

        canonical_policy = (
            "cli_reference_base_range_"
            "plus_hardware_overlay"
        )


    # ========================================================
    # RULE 2 — valeur sentinelle explicite
    # ========================================================

    elif special_values:

        resolution = (
            "sentinel_value_plus_normal_range"
        )

        status = "resolved"

        confidence = "high"

        canonical_policy = (
            "cli_reference_normal_range_"
            "plus_special_values"
        )


    # ========================================================
    # RULE 3 — Ansible confirme exactement la CLI
    # ========================================================

    elif (
        ans_supports_cli
        and not ans_supports_tf
    ):

        resolution = (
            "terraform_constraint_mismatch"
        )

        status = "resolved"

        confidence = "high"

        canonical_policy = (
            "prefer_exact_version_cli_range"
        )


    # ========================================================
    # RULE 4 — Ansible confirme Terraform au lieu de CLI
    # ========================================================

    elif (
        ans_supports_tf
        and not ans_supports_cli
    ):

        resolution = (
            "secondary_sources_disagree_with_exact_cli"
        )

        status = "resolved"

        confidence = "medium"

        canonical_policy = (
            "prefer_exact_version_cli_range"
        )


    # ========================================================
    # RULE 5 — unités différentes
    # ========================================================

    elif unit_mismatch:

        resolution = (
            "unit_or_semantic_disagreement"
        )

        status = "unresolved"

        confidence = "needs_review"

        canonical_policy = None


    # ========================================================
    # RULE 6 — Ansible possède un troisième range
    # différent de CLI ET Terraform
    # ========================================================

    elif (
        ans_ranges
        and not ans_supports_cli
        and not ans_supports_tf
    ):

        resolution = (
            "secondary_sources_disagree_with_exact_cli"
        )

        status = "resolved"

        confidence = "medium"

        canonical_policy = (
            "prefer_exact_version_cli_range"
        )


    # ========================================================
    # RULE 7 — seulement CLI exacte vs provider Terraform
    #
    # La CLI Reference de la version reste l'autorité produit
    # mais on conserve le désaccord dans evidence.
    # ========================================================

    else:

        resolution = (
            "exact_version_cli_preferred"
        )

        status = "resolved"

        confidence = "medium"

        canonical_policy = (
            "prefer_exact_version_cli_range"
        )


    result = dict(item)

    result.update({

        "resolution":
            resolution,

        "status":
            status,

        "confidence":
            confidence,

        "canonical_policy":
            canonical_policy,

        "ansible_ranges_detected": [
            [
                number_text(a),
                number_text(b),
            ]
            for a, b
            in ans_ranges
        ],

        "ansible_supports_cli":
            ans_supports_cli,

        "ansible_supports_terraform":
            ans_supports_tf,

        "cli_units":
            sorted(cli_units),

        "ansible_units":
            sorted(ans_units),

        "special_values":
            special_values,

        "requires_hardware_overlay":
            platform,

        "cli_ranges_detected": [
            [
                number_text(a),
                number_text(b),
            ]
            for a, b
            in cli_ranges_detected
        ],

        "cli_internal_inconsistency":
            cli_internal_inconsistency,

        "requires_runtime_validation":
            (
                status == "unresolved"
                or confidence == "medium"
            ),
    })


    summary[
        resolution
    ] += 1

    final_records.append(
        result
    )


unresolved = [
    x
    for x in final_records
    if x["status"]
    == "unresolved"
]


final = {

    "version":
        args.version,

    "total":
        len(final_records),

    "resolved":
        len(final_records)
        - len(unresolved),

    "unresolved":
        len(unresolved),

    "summary":
        dict(summary),

    "records":
        final_records,
}


OUTPUT.write_text(
    yaml.safe_dump(
        final,
        sort_keys=False,
        allow_unicode=True
    ),
    encoding="utf-8"
)


print()
print(
    f"=== RANGE RESOLUTION {args.version} ==="
)

print(
    "Total      :",
    len(final_records)
)

print(
    "Resolved   :",
    final["resolved"]
)

print(
    "Unresolved :",
    final["unresolved"]
)


print()
print(
    "=== RESOLUTION CLASSES ==="
)


for name, count in (
    summary.most_common()
):

    print(
        f"{name:45} {count}"
    )


if unresolved:

    print()
    print(
        "=== STILL UNRESOLVED ==="
    )

    for item in unresolved[
        :args.samples
    ]:

        print()
        print(
            item.get("section"),
            "::",
            item.get("attribute"),
            "::",
            item.get("field")
        )

        print(
            " values:",
            item.get("values")
        )

        print(
            " resolution:",
            item.get("resolution")
        )

        print(
            " ansible ranges:",
            item.get(
                "ansible_ranges_detected"
            )
        )

        print(
            " units CLI:",
            item.get("cli_units")
        )

        print(
            " units Ansible:",
            item.get("ansible_units")
        )


print()
print(
    "[OK] Report:",
    OUTPUT
)
